# Copy to .env in the repo root. Never commit .env.

# myDATA REST API (https://mydata.aade.gr -> Εγγραφή στο REST API). Read-only use.
MYDATA_USER=your-aade-user-id
MYDATA_KEY=your-subscription-key
MYDATA_ENV=prod

# SAP Business One Service Layer (only if erp.adapter = sap_b1)
SAP_URL=https://your-b1-host/b1s/v1
SAP_DB=COMPANY_DB
SAP_USER=b1user
SAP_PASS=change-me
# 0 = read only. issue.py sets it to 1 for a single run when you pass --yes.
WRITE_ENABLED=0

# SoftOne / Soft1 Web Services (only if erp.adapter = softone)
S1_URL=https://go.s1cloud.net
S1_CODE=your-s1code
S1_APPID=your-app-id
S1_TOKEN=your-token
